# ==============================================================================
# AVRO CUSTOMER STOREFRONT — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in your customer store installation directory:
#   cp .env.example .env
# Fill in your database credentials and production store domain.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
STORE_NAME="My Premium Store"
STORE_DOMAIN="store.yourbrand.com"
STORE_URL="https://store.yourbrand.com"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL / SUPABASE / NEON / AWS RDS)
# ------------------------------------------------------------------------------
# For Docker Compose (Built-in Postgres container):
# DATABASE_URL="postgresql://avro_user:avro_secure_password_2026@avro-db:5432/avro_store_db?schema=public"

# For Supabase (Recommended for Cloud / Serverless):
DATABASE_URL="postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x"
DIRECT_URL="postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Alternatively, standard standalone PostgreSQL instance:
# DATABASE_URL="postgresql://username:password@localhost:5432/avro_store?schema=public"

# ------------------------------------------------------------------------------
# 3. SECURITY & SESSION TOKENS
# ------------------------------------------------------------------------------
# Generate strong, random 64-character strings for production:
JWT_SECRET="avro_prod_jwt_secret_change_me_to_a_secure_random_string_64char"
ADMIN_COOKIE_SECRET="avro_cookie_secret_change_me_to_a_secure_random_string"

# ------------------------------------------------------------------------------
# 4. TECHNEXT CENTRAL LICENSING & HEARTBEAT
# ------------------------------------------------------------------------------
# The central TECHNEXT licensing server URL for heartbeat sync:
CENTRAL_API_URL="https://licensing.technext.co/api/v1"

# Your purchased AVRO license key (Format: AVRO-<PLAN>-<12 HEX>-<4 CHECKSUM>):
# If left blank, you will be prompted to enter it during the first-time /setup wizard.
AVRO_LICENSE_KEY="AVRO-GROW-8F3C7B21A90E-7C32"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAYS (OPTIONAL - CAN ALSO BE CONFIGURED IN STORE ADMIN)
# ------------------------------------------------------------------------------
# Razorpay Credentials (Optional)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# PhonePe Credentials (Optional)
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"

# Stripe Credentials (Optional)
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 6. LOGISTICS & COURIERS (OPTIONAL - CAN ALSO BE CONFIGURED IN STORE ADMIN)
# ------------------------------------------------------------------------------
# Shiprocket API
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# Delhivery API
DELHIVERY_API_TOKEN=""
