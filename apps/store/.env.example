# ==========================================
# AVRO SELF-HOSTED CUSTOMER STORE ENVIRONMENT
# ==========================================

# 1. DATABASE CONFIGURATION (PostgreSQL Recommended for Production)
# Example for Docker PostgreSQL:
DATABASE_URL="postgresql://avro_user:your_secure_password@localhost:5432/avro_store_db?schema=public"
# Example for local SQLite development:
# DATABASE_URL="file:./dev.db"

# 2. APPLICATION CONFIGURATION
NODE_ENV="production"
PORT=3001
STORE_DOMAIN="mystore.example.com"
NEXT_PUBLIC_APP_URL="https://mystore.example.com"

# 3. SECURITY & AUTHENTICATION
JWT_SECRET="replace_with_a_random_64_character_hex_secret_for_store_sessions"
INSTALLATION_UUID="generate_unique_uuid_or_leave_blank_for_auto_generation"

# 4. CENTRAL LICENSING CONNECTION
# The public HTTPS URL of the TECHNEXT Central Platform API
CENTRAL_API_URL="https://licensing.technext.co/api/v1"
# Master HMAC key used to verify entitlement token signatures (matches Central license core)
LICENSE_HMAC_SECRET="technext_avro_license_hmac_master_secret_2026"
