datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("SUPER_ADMIN") // SUPER_ADMIN, SUPPORT, BILLING
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id            String               @id @default(cuid())
  name          String
  email         String               @unique
  passwordHash  String
  companyName   String?
  phone         String?
  status        String               @default("ACTIVE") // ACTIVE, SUSPENDED
  internalNotes String?
  subscriptions Subscription[]
  licenses      License[]
  tickets       SupportTicket[]
  quotes        CustomizationQuote[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Plan {
  id               String         @id @default(cuid())
  tier             String         @unique // BASIC, GROW, PLUS
  name             String
  description      String
  badge            String?
  isActive         Boolean        @default(true)
  entitlementsJson String // JSON of LicenseEntitlements
  pricingTiers     PricingTier[]
  subscriptions    Subscription[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model PricingTier {
  id              String   @id @default(cuid())
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  duration        String // MONTHLY, SIX_MONTHS, YEARLY, TWO_YEARS
  price           Float
  originalPrice   Float?
  discountPercent Float    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([planId, duration])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Promotion {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Float
  maxDiscount     Float?
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Subscription {
  id                 String   @id @default(cuid())
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan     @relation(fields: [planId], references: [id])
  duration           String // MONTHLY, SIX_MONTHS, YEARLY, TWO_YEARS
  status             String   @default("ACTIVE") // ACTIVE, PAST_DUE, EXPIRED, CANCELLED, SUSPENDED
  amount             Float
  currency           String   @default("INR")
  startDate          DateTime @default(now())
  endDate            DateTime
  hasSetupAssistance Boolean  @default(false)
  setupFee           Float    @default(0)
  paymentStatus      String   @default("PAID") // PAID, PENDING, FAILED
  paymentReference   String?
  license            License?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model License {
  id               String                 @id @default(cuid())
  licenseKey       String                 @unique
  customerId       String
  customer         Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId   String                 @unique
  subscription     Subscription           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  planTier         String // BASIC, GROW, PLUS
  boundDomain      String?
  installationUuid String?
  status           String                 @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED, EXPIRED
  activatedAt      DateTime?
  expiresAt        DateTime
  lastHeartbeatAt  DateTime?
  validationLogs   LicenseValidationLog[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model LicenseValidationLog {
  id               String   @id @default(cuid())
  licenseId        String
  license          License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  licenseKey       String
  domain           String?
  installationUuid String?
  storeVersion     String?
  ipAddress        String?
  outcome          String // SUCCESS, INVALID_DOMAIN, EXPIRED, REVOKED, NOT_FOUND
  timestamp        DateTime @default(now())
}

model SoftwareRelease {
  id               String   @id @default(cuid())
  version          String   @unique
  releaseDate      DateTime @default(now())
  isLatest         Boolean  @default(false)
  isSecurityUpdate Boolean  @default(false)
  changelog        String
  downloadUrl      String?
  createdAt        DateTime @default(now())
}

model SupportTicket {
  id            String          @id @default(cuid())
  ticketNumber  String          @unique
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subject       String
  category      String
  priority      String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status        String          @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  internalNotes String?
  messages      TicketMessage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType String // CUSTOMER, ADMIN
  senderName String
  message    String
  createdAt  DateTime      @default(now())
}

model CustomizationQuote {
  id               String   @id @default(cuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title            String
  scopeDescription String
  quotedAmount     Float
  status           String   @default("SENT") // DRAFT, SENT, ACCEPTED, REJECTED, PAID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CentralThemeItem {
  id           String   @id @default(cuid())
  themeCode    String   @unique
  name         String
  description  String
  previewImage String?
  isPremium    Boolean  @default(false)
  price        Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemBroadcast {
  id         String    @id @default(cuid())
  title      String
  message    String
  severity   String    @default("INFO") // INFO, WARNING, CRITICAL
  targetTier String    @default("ALL") // ALL, BASIC, GROW, PLUS
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String   @default("admin@technext.co")
  action     String // e.g. "LICENSE_GENERATED", "VERSION_RELEASED", "QUOTE_ISSUED"
  target     String // e.g. "License AVRO-PLUS-XXXX", "Customer Rajesh"
  details    String?
  ipAddress  String?  @default("127.0.0.1")
  severity   String   @default("NORMAL") // NORMAL, WARNING, CRITICAL
  timestamp  DateTime @default(now())
}
