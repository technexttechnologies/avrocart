{
  "name": "avro-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3001",
    "build": "node scripts/prepare-prisma.js && npx prisma generate && next build",
    "build:store": "node scripts/prepare-prisma.js && npx prisma generate && next build",
    "vercel-build": "node scripts/prepare-prisma.js && npx prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3001",
    "lint": "next lint",
    "db:generate": "node scripts/prepare-prisma.js && npx prisma generate",
    "db:push": "node scripts/prepare-prisma.js && npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "connect:supabase": "node scripts/connect-supabase.js",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.378.0",
    "next": "^14.2.3",
    "nodemailer": "^10.3.1",
    "prisma": "^5.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  }
}
