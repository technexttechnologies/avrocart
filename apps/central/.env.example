# 1. DATABASE CONFIGURATION (PostgreSQL Recommended for Production)
DATABASE_URL="postgresql://technext_admin:your_secure_password@localhost:5432/avro_central_db?schema=public"
# Example for local SQLite development:
# DATABASE_URL="file:./dev.db"

# 2. APPLICATION CONFIGURATION
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://licensing.technext.co"

# 3. SECURITY & CRYPTOGRAPHY
JWT_SECRET="replace_with_a_random_64_character_hex_secret_for_central_admin_sessions"
LICENSE_HMAC_SECRET="technext_avro_license_hmac_master_secret_2026"

# 4. INITIAL ADMIN SEED CREDENTIALS
ADMIN_INITIAL_EMAIL="admin@technext.co"
ADMIN_INITIAL_PASSWORD="SecureAdminPassword2026!"
